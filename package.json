{
  "name": "llm-school",
  "version": "0.0.1",
  "private": true,
  "description": "LLM을 만지면서 배우는 한국어 인터랙티브 학습 사이트",
  "scripts": {
    "dev": "concurrently -k \"velite --watch\" \"next dev\"",
    "build": "velite --strict && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:content": "velite --strict && tsx scripts/lint-content.ts",
    "lint:styles": "stylelint \"src/**/*.css\" && tsx scripts/lint-hex.ts",
    "ci": "npm run build && npm run typecheck && npm run test && npm run lint:content && npm run lint:styles"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@shikijs/rehype": "^4.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.3",
    "katex": "^0.18.1",
    "pretendard": "^1.3.9",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.2",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5",
    "velite": "^0.4.0",
    "vitest": "^4.1.10"
  }
}
